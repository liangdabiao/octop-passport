# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 三字经应用要同时持有约 40~60 个控件(首页一行 3 个对象、认字卡三格田字格各 13 个),
# 24KB 会不够;64KB 留出余量,仍只占内部 RAM 的一小部分(本板无 PSRAM,但也无 Wi-Fi/BT
# 运行时占用)。
# 本应用 UI 只有状态栏/正文/页脚 3 个 label：28KB 池足够（家族 96KB 池是给
# 围棋/七桥复杂画面的；这台无 PSRAM 的板上 64KB 池曾把门户压到 3.6KB 堆）。
# 注意：LV_MEM_SIZE（字节）会压过 KILOBYTES，两个键必须一致地写，且改完要
# 删掉根目录 sdkconfig 让它从 defaults 重新生成（IDF 不会自动应用 defaults 变更）。
CONFIG_LV_MEM_SIZE=28672
CONFIG_LV_MEM_SIZE_KILOBYTES=28

# --- 中文字库 ---
# 界面文字全部由 tools/sanzijing/gen_font.py 生成的 16/24/32 三档子集提供
# (assets/fonts/szj_font_*.c),不依赖 LVGL 内置的 Source Han 子集,也不依赖
# Montserrat 兜底 —— 生成阶段会逐个码点核对字体覆盖,漏字会直接报错而不是变成空白框。
# 未压缩点阵直接放在 Flash 里内存映射读取,不需要 CONFIG_LV_USE_FONT_COMPRESSED。
# 32px 那一档的位图约 316 KB,字形偏移量按字节存放,超过 16 位能表达的范围,
# 所以必须打开 LVGL 的「大字体」模式(它把 bitmap_index 从 uint16 换成 uint32)。
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# --- 系统 ---
# 崩溃/看门狗转储给出基于帧指针的完整回溯——没有它，WDT 转储只有裸 PC，
# 调不出调用链（家族应用渲染卡死排查的实际教训）。
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
CONFIG_FREERTOS_HZ=1000
# 主任务栈 12288：冒烟/初始化路径若在 main_task 上触发大栈上缓冲的调用
# （如 AI 搜索递归 ~6.5KB），默认 3584 会爆栈（画刊应用同一教训与同一取值）。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# --- Bluetooth LE ---
# 关闭。本应用不用蓝牙；C3 的内部堆只有 ~106KB，NimBLE 常驻要吃掉 ~70KB ——
# 棋盘视图有 225 个棋子对象、AI 搜索任务要 12KB 栈，这些堆省下来都用得上。
# （画刊应用同一决定，真机实测省出 ~70KB。）

# 中文显示（本应用正文为服务器动态中文，见 docs/development/engineering/lvgl-chinese-fonts.zh_CN.md）：
# UTF-8 编码 + 缺字占位保持可见（GB2312 常用集之外的字形显示占位符，不静默吞掉）。
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
